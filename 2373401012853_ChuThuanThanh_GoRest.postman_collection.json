      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const data = pm.response.json();\r\n\r\n    pm.test(\"User ID exists\", function () {\r\n        pm.expect(data.id).to.exist;\r\n    });\r\n\r\n    pm.test(\"Response matches CSV data\", function () {\r\n        pm.expect(data.name).to.eql(\r\n            pm.iterationData.get(\"name\")\r\n        );\r\n        pm.expect(data.gender).to.eql(\r\n            pm.iterationData.get(\"gender\")\r\n        );\r\n        pm.expect(data.email).to.eql(\r\n            pm.iterationData.get(\"email\")\r\n        );\r\n        pm.expect(data.status).to.eql(\r\n            pm.iterationData.get(\"status\")\r\n        );\r\n    });\r\n\r\n    pm.environment.set(\"userId\", String(data.id));\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
